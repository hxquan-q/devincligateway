   "api_server_url": "https://server.codeium.com"
  },
  {
   "name": "a3-proxy",
   "api_key": "devin-session-token$<JWT>",
   "api_server_url": "https://server.codeium.com",
   "proxy": "socks5://user:pass@PROXY_HOST:PORT"
  }
 ]
